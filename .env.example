# Free Realtime Trains API account: https://api.rtt.io
RTT_USERNAME=
RTT_PASSWORD=
# Optional: if set, the board and widget need ?key=<this> in the URL
COMMUTE_KEY=
# Your home location (walk time to Barnes station is worked out from it), or set COMMUTE_WALK_MINUTES directly
COMMUTE_HOME_LAT=
COMMUTE_HOME_LON=
COMMUTE_WALK_MINUTES=
# Minutes to get out of the door, and minutes to spare on the platform
COMMUTE_GET_OUT_MINUTES=2
COMMUTE_PLATFORM_BUFFER_MINUTES=1
# White Hart Lane barrier comes down this long before a train reaches the crossing, and goes up this long after
COMMUTE_BARRIER_CLOSE_BEFORE_MINUTES=3
COMMUTE_BARRIER_OPEN_AFTER_MINUTES=1
# If your walk to the station crosses the barrier: minutes from your front door to the crossing (leave blank if not)
COMMUTE_WALK_TO_CROSSING_MINUTES=
# Live barrier: address of the always-on worker in worker/barrier, and its WORKER_KEY
BARRIER_LIVE_URL=
BARRIER_LIVE_KEY=
